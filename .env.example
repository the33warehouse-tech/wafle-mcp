# wafle-mcp configuration

# wafle REST API base URL (no trailing slash)
WAFLE_API_URL=https://wafle.click/wp-json/waffle/v1

# wafle admin key (from /root/.waffle-creds.txt on the waffle container)
# Sent on every upstream request as `X-Wafle-Admin-Key`. KEEP SECRET.
WAFLE_API_KEY=

# Optional request timeout in ms (default 30000)
WAFLE_TIMEOUT_MS=30000

# HTTP transport settings (only used when --transport=http)
WAFLE_MCP_HTTP_HOST=0.0.0.0
WAFLE_MCP_HTTP_PORT=7100

# Tenant-scoped JWT auth (recommended path).
# Shared HS256 secret used to verify per-tenant JWTs minted by the wafle
# backend (`POST /admin/account/mcp/issue-token`). Generate with:
#   openssl rand -hex 64
WAFLE_MCP_JWT_SECRET=
# Set to 1 to refuse the legacy admin bearer fallback (recommended in prod).
WAFLE_MCP_REQUIRE_JWT=

# Legacy admin-tier bearer tokens (cross-tenant). Comma-separated. Used as
# fallback when WAFLE_MCP_REQUIRE_JWT is unset. Generate with `openssl rand -hex 32`.
WAFLE_MCP_TOKENS=

# Logging
LOG_LEVEL=info
NODE_ENV=production
